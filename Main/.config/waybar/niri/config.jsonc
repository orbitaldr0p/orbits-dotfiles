{
    "layer": "top",
    "output": [
        "eDP-1"
    ],
    "include": ["~/.config/waybar/niri/modules.jsonc"],
    "modules-left": [
        "group/cpu",
        "memory",
        "niri/workspaces",
        "group/trayDrawer"
    ],
    "modules-center": [
        "group/player"
    ],
    "modules-right": [
        "clock",
        "backlight",
        "pulseaudio",
        "bluetooth",
        "group/network",
        "battery",
        "group/misc"
    ],
    "margin": "6, 6, 0, 6"
}