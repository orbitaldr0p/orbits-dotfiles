{
    "layer": "top",
    "output": [
        "eDP-1"
    ],
    "include": [
        "~/.config/waybar/niri/modules.jsonc",
        "~/.config/waybar/niri/groups.jsonc"
    ],
    "modules-left": [
        "group/cpu",
        "memory",
        "disk",
        "niri/workspaces",
        "group/trayDrawer"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "clock",
        "backlight",
        "pulseaudio",
        "bluetooth",
        "group/network",
        "group/battery",
        "group/misc"
    ],
    "margin": "5, 5, 0, 5"
}