{
    //==================================================================================================
    "group/cpu": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "children-class": "cpuGroup",
            "transition-left-to-right": true
        },
        "modules": [
            "cpu#load",
            "cpu#freq",
            "temperature",
            "custom/divider"
        ]
    },
    "group/trayDrawer": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "children-class": "trayGroup",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/trayIconRight",
            "custom/divider",
            "tray"
        ]
    },
    "group/player": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "children-class": "playerGroup"
        },
        "modules": [
            "mpris#main",
            "mpris#extended"
        ]
    },
    "group/network": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "children-class": "networkGroup",
            "transition-left-to-right": true
        },
        "modules": [
            "network#icon",
            "network#ssid"
        ]
    },
    "group/battery": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "children-class": "batteryGroup",
            "transition-left-to-right": true
        },
        "modules": [
            "battery#main",
            "battery#timeRemaining"
        ]
    },
    "group/misc": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "children-class": "miscGroup",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/misc",
            "idle_inhibitor",
            "custom/clipboard",
            "custom/colourpicker"
        ]
    },
    //==================================================================================================
    "cpu#load": {
        "interval": "1",
        "format": " {usage}%",
        "on-click": "foot -T 'ftui-System Monitor' -e btop",
        "on-click-right": "foot -T 'ftui-GPU Status' -e nvtop"
    },
    "cpu#freq": {
        "interval": "1",
        "format": "{avg_frequency}GHz",
        "on-click": "foot -T 'ftui-System Monitor' -e btop",
        "on-click-right": "foot -T 'ftui-GPU Status' -e nvtop"
    },
    "memory": {
        "interval": 1,
        "format": "󰘚 {percentage}%"
    },
    "temperature": {
        "format": "{icon} {temperatureC}°C",
        "format-icons": [
            "",
            "",
            "",
            ""
        ],
        "format-critical": " {temperatureC}°C ",
        "tooltip": false,
        "critical-threshold": 80
    },
    "disk": {
        "interval": 10,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "on-click": "foot -T 'ftui-Disk Usage' -e diskonaut"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "tooltip": false,
        "all-outputs": false,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        },
        "format-icons": {
            "active": "",
            "default": ""
        }
    },
    "custom/trayIconRight": {
        "format": "",
        "tooltip": false
    },
    "tray": {
        //"icon-size": 20,
        "spacing": 15
    },
    "hyprland/window": {
        "format": "{}",
        "rewrite": {
            "foot": "",
            "~": "",
            "(.*) ~": " $1",
            "ftui-(.*)":"$1",
            "LibreWolf": "󰈹",
            "(.*) - VSCodium": " $1",
            "(.*) — LibreWolf": "󰈹 $1",
            //".*TIDAL.*": "TIDAL",
            "(.*) — Strawberry Music Player":" $1",
            "Discord(.*)":"Vesktop$1"
        },
        "separate-outputs": true,
        "max-length": 40
    },
    "mpris#main": {
        "format": "{status_icon} {title}",
        "format-stopped": "",
        "player-icons": {
            "default": "󰐊",
            "firefox": ""
        },
        "status-icons": {
            "playing": "󰐊",
            "paused": ""
        },
        "ignored-players": [
            "firefox",
            "kdeconnect"
        ],
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "mpris#extended": {
        "format": " - {artist}",
        "format-stopped": "",
        "ignored-players": [
            "firefox",
            "kdeconnect"
        ],
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%R 󰃭 %d·%m·%y}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "tooltip": false,
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#c6d0f5'><b>{}</b></span>",
                "weekdays": "<span color='#c6d0f5'><b>{}</b></span>",
                "today": "<span color='#ef9f76'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ],
        "on-scroll-up": "~/.scripts/System/brightnessControl.sh i",
        "on-scroll-down": "~/.scripts/System/brightnessControl.sh d",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰸈 Off",
        "tooltip": false,
        "format-icons": {
            "headphone": "",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "ignored-sinks": [
            "Easy Effects Sink"
        ],
        "on-click-middle": "~/.scripts/System/volumeControl.sh m",
        "on-scroll-up": "~/.scripts/System/volumeControl.sh i",
        "on-scroll-down": "~/.scripts/System/volumeControl.sh d",
        "on-click": "pwvucontrol"
    },
    "bluetooth": {
        "format": " On",
        "format-disabled": "󰂲", // an empty format will hide the module
        "format-connected": " {num_connections}",
        "tooltip-format": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}{device_address}",
        "on-click": "blueberry"
    },
    "network#icon": {
        "interval": 1,
        "format": "{icon}",
        "tooltip-format": " {bandwidthUpBytes}  {bandwidthDownBytes}",
        "format-icons": {
            "wifi": [
                "󰤟",
                "󰤢",
                "󰤥",
                "󰤨"
            ],
            "ethernet": "󰈀",
            "disconnected": "󰤮",
            "disabled": "󰤮"
        },
        "on-click": "network_manager"
    },
    "network#ssid": {
        "interval": 1,
        "format": "{essid}",
        "format-disconnected": "disconnected",
        "format-disabled": "off",
        "tooltip-format": " {bandwidthUpBytes}  {bandwidthDownBytes}",
        "on-click": "network_manager"
    },
    "battery#main": {
        "interval": 1,
        "format": "{icon} {capacity}%",
        "format-icons": [
            "󰂃",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "format-charging": "󰂄 {capacity}%",
        "tooltip": false,
        "on-click": "foot -T 'ftui-Battery Status' -e battop",
        "on-click-right": "~/.scripts/System/powerProfile.sh",
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 20
        }
    },
    "battery#timeRemaining": {
        "interval": 1,
        "format": "{time}",
        "format-full": "Full",
        "on-click": "foot -T 'ftui-Battery Status' -e battop",
        "on-click-right": "~/.scripts/System/powerProfile.sh",
        "tooltip": false,
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 20
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile} ",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "custom/clipboard": {
        "format": "",
        "tooltip": false,
        "on-click": "foot -T 'ftui-Clipboard History' -e clipse"
    },
    "custom/colourpicker": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.scripts/eyedropper.sh"
    },
    "custom/misc": {
        "format": "",
        "tooltip": false,
        "on-click": "ignis open rightPanel"
    },
    "custom/easyeffects": {
        "exec": "~/.scripts/easyEffects.sh c",
        "on-click": "~/.scripts/easyEffects.sh t",
        "on-click-right": "easyeffects",
        "interval": 1
    },
    "custom/divider": {
        "format": "|",
        "tooltip": false
    }
}